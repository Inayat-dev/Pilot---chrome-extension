{
  "manifest_version": 3,
  "name": "Pilot — AI Browser Copilot",
  "version": "1.4.6",
  "description": "An AI agent that reads and acts on the page you're on. Save multiple API keys per provider and Pilot automatically rotates to the next one when one hits a rate limit — plus request timeouts and a Fast mode for snappier runs. Works with cloud providers or a fully local Ollama model.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Pilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "commands": {
    "open-pilot": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open Pilot's side panel"
    }
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
