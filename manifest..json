{
  "manifest_version": 3,
  "name": "Telegram Web Auto Sender",
  "version": "1.0",
  "description": "Auto‑type and send messages in Telegram Web group chats.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://web.telegram.org/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to active chat"
  },
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}